# Rebuild the welcome gate's plants.local.js + photos from live HortusFox.
#   sudo cp deploy/hortusfox-gate-bake.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now hortusfox-gate-bake.timer
# A failed run leaves the last good build live; see `journalctl -u hortusfox-gate-bake`.
[Unit]
Description=HortusFox welcome gate: nightly rebuild from live data
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/opt/hortusfox-gate/deploy/bake.sh
TimeoutStartSec=10min
